instance/

# NutriAI Specific Exclusions
# -------------------------
# Exclude raw image dataset folder and archive
dataset/
dataset.zip
WebInterface.zip
ModelP/

# Exclude model weights (large binary files > 100MB)
Models/*.pth
Models/*.pt
WebInterface/models/*.pth
WebInterface/models/*.pt

# Exclude large media/videos
IMP/*.mp4
IMP/*.avi
IMP/*.mkv

# Temporary upload folder contents
WebInterface/static/uploads/*
!WebInterface/static/uploads/.gitkeep
